{
    "dataRoles": [
        {
            "name": "origin",
            "displayName": "Origin",
            "description": "Origin terminal or port name. Shown in labels and tooltips.",
            "kind": "Grouping"
        },
        {
            "name": "originLat",
            "displayName": "Origin latitude",
            "description": "Decimal degrees, -90 to 90. A text column holding a number also works.",
            "kind": "Grouping",
            "preferredTypes": [
                {
                    "geography": {
                        "latitude": true
                    }
                }
            ]
        },
        {
            "name": "originLon",
            "displayName": "Origin longitude",
            "description": "Decimal degrees, -180 to 180. A text column holding a number also works.",
            "kind": "Grouping",
            "preferredTypes": [
                {
                    "geography": {
                        "longitude": true
                    }
                }
            ]
        },
        {
            "name": "destination",
            "displayName": "Destination",
            "description": "Destination terminal or port name. Shown in labels and tooltips.",
            "kind": "Grouping"
        },
        {
            "name": "destLat",
            "displayName": "Destination latitude",
            "description": "Decimal degrees, -90 to 90. A text column holding a number also works.",
            "kind": "Grouping",
            "preferredTypes": [
                {
                    "geography": {
                        "latitude": true
                    }
                }
            ]
        },
        {
            "name": "destLon",
            "displayName": "Destination longitude",
            "description": "Decimal degrees, -180 to 180. A text column holding a number also works.",
            "kind": "Grouping",
            "preferredTypes": [
                {
                    "geography": {
                        "longitude": true
                    }
                }
            ]
        },
        {
            "name": "volume",
            "displayName": "Volume",
            "description": "Sets the line width. Values are shown with this measure's format.",
            "kind": "Measure",
            "requiredTypes": [
                {
                    "numeric": true
                },
                {
                    "integer": true
                }
            ]
        },
        {
            "name": "color",
            "displayName": "Color by",
            "description": "Optional category that colors the flows, e.g. product. Needs Volume. Each value gets its own color in the Format pane.",
            "kind": "Grouping"
        },
        {
            "name": "canal",
            "displayName": "Canal transit",
            "description": "Optional list of canals/straits passed, e.g. Kpler \"Zone Canal Transit\". The Maritime style routes through them.",
            "kind": "Grouping"
        },
        {
            "name": "tooltips",
            "displayName": "Tooltips",
            "description": "Extra values to show when hovering a flow.",
            "kind": "Measure"
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "origin": {
                        "max": 1
                    },
                    "originLat": {
                        "max": 1
                    },
                    "originLon": {
                        "max": 1
                    },
                    "destination": {
                        "max": 1
                    },
                    "destLat": {
                        "max": 1
                    },
                    "destLon": {
                        "max": 1
                    },
                    "volume": {
                        "max": 1
                    },
                    "color": {
                        "max": 1
                    },
                    "canal": {
                        "max": 1
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "select": [
                        {
                            "bind": {
                                "to": "origin"
                            }
                        },
                        {
                            "bind": {
                                "to": "originLat"
                            }
                        },
                        {
                            "bind": {
                                "to": "originLon"
                            }
                        },
                        {
                            "bind": {
                                "to": "destination"
                            }
                        },
                        {
                            "bind": {
                                "to": "destLat"
                            }
                        },
                        {
                            "bind": {
                                "to": "destLon"
                            }
                        },
                        {
                            "bind": {
                                "to": "canal"
                            }
                        }
                    ],
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 30000
                        }
                    }
                },
                "values": {
                    "group": {
                        "by": "color",
                        "select": [
                            {
                                "bind": {
                                    "to": "volume"
                                }
                            },
                            {
                                "for": {
                                    "in": "tooltips"
                                }
                            }
                        ],
                        "dataReductionAlgorithm": {
                            "top": {
                                "count": 60
                            }
                        }
                    }
                }
            }
        }
    ],
